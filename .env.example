# Copy to `.env` in this directory (repo root). `Scripts/run_local_server.sh` loads `.env` before starting Vapor.
# Never commit `.env` — it may contain secrets.

# HTTP bind (defaults: 127.0.0.1 / 8080)
# BIND_HOST=127.0.0.1
# PORT=8080

# OpenAI image generation (optional; omit for mock image URL)
# OPENAI_API_KEY=

# Guard POST /api/artworks/* (optional)
# GENERATION_API_TOKEN=
# GENERATION_RATE_LIMIT_PER_MINUTE=20

# Supabase: when both are set, generation history and gallery catalog load from Postgres (PostgREST).
# Apply migrations under supabase/migrations/ before enabling.
# SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=

# Administrator API (optional). When set, iOS “Administrator…” (Exhibitions overflow menu) can call /api/admin/* with the same value in X-Admin-Token.
# ADMIN_API_TOKEN=

# Optional override path for operator policy JSON (checkout + generation toggles). Default: Server/Data/admin-policy.json under the repo.
# ADMIN_POLICY_PATH=

# Dola Smart AI Assistant (refines image-generation prompts via POST /api/dola/assist).
# When OPENAI_API_KEY is set, Dola uses OpenAI Chat Completions; otherwise it falls back to a
# deterministic mock provider (still useful for tests / first-runs).
# DOLA_ASSISTANT_MODEL=gpt-4o-mini
# DOLA_ASSISTANT_PROVIDER=mock        # force the mock provider even when OPENAI_API_KEY is set
