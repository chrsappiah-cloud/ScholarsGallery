# Alpaca Markets (paper trading & market data)
# Get free paper keys at https://alpaca.markets
ALPACA_API_KEY=your_alpaca_key_here
ALPACA_API_SECRET=your_alpaca_secret_here
# Leave blank to default to paper endpoint
ALPACA_BASE_URL=

# Database (defaults to SQLite for local dev; set to postgres for production)
# SQLite default — no setup needed
DATABASE_URL=sqlite:///./aifinance.db
# Postgres example:
# DATABASE_URL=postgresql://aifinance:aifinance@localhost:5432/aifinance

# Trading mode at startup: simulation | paper | live
TRADING_MODE=simulation
